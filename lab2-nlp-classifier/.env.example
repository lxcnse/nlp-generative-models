# Skopiuj ten plik jako .env i uzupelnij wartosci.
TELEGRAM_BOT_TOKEN=wklej_token_od_BotFather
ALBUM_NUMBER=123456
DB_PATH=data/tasks.db
SPACY_MODEL=pl_core_news_sm
LOG_LEVEL=INFO

# --- zadanie 2 (klasyfikacja) ---
# pierwsza litera nazwiska -> wybor 2 metod klasyfikacji (C -> AdaBoost + Decision Tree)
SURNAME_INITIAL=C
MODELS_DIR=models
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# ile przykladow na klase pobierac ze zbiorow agnews / 20newsgroups
SAMPLES_PER_CLASS=1000
